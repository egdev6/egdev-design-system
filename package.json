{
  "name": "egdev-design-system",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "typecheck": "tsc --noEmit && pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "hooks:install": "lefthook install",
    "lint": "biome check .",
    "format": "biome check --write .",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1",
    "storybook-build": "storybook build",
    "test:storybook-mcp": "node --test scripts/storybook-mcp.test.mjs",
    "test:package-exports": "node --test scripts/package-exports.test.mjs",
    "test:package-consumption": "node --test scripts/package-consumption.test.mjs",
    "tokens": "pnpm --filter @egdev/tokens run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-mcp": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react-swc": "4.3.3",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "29.1.1",
    "lefthook": "2.2.1",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-docgen-typescript": "2.4.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.1.11"
  }
}
